# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is already in .gitignore.

# ── Which AI grades? ─────────────────────────────────────────
# One of: openai | anthropic | local
#   openai     the default — OpenAI's API
#   anthropic  Anthropic's Claude API
#   local      any local OpenAI-compatible server (vLLM, Ollama, LM Studio)
# Everything else (upload, parsing, similarity detection, export) works
# regardless of which one you pick, and with no key at all.
LLM_PROVIDER=openai

# ── OpenAI (used when LLM_PROVIDER=openai) ───────────────────
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# Leave OPENAI_BASE_URL blank for the real OpenAI API. Set it only to use an
# OpenAI-compatible gateway (Azure OpenAI, OpenRouter, ...).
OPENAI_BASE_URL=
# Any model your account can call. gpt-4o supports both vision and strict
# JSON, which grading relies on.
OPENAI_GRADING_MODEL=gpt-4o
OPENAI_RUBRIC_MODEL=gpt-4o-mini

# ── Local model (used when LLM_PROVIDER=local) ───────────────
# Point this at a local server that speaks the OpenAI API. Examples:
#   Ollama:    http://localhost:11434/v1   (run: ollama serve)
#   vLLM:      http://localhost:8000/v1
#   LM Studio: http://localhost:1234/v1
# IMPORTANT under Docker: "localhost" means the *container*, not your
# machine. Use host.docker.internal to reach Ollama running on the host:
#   host + Docker on one machine : http://host.docker.internal:11434/v1
#   Ollama on another server     : http://ollama.your-university.edu:11434/v1
#   running AutoGrade without Docker: http://localhost:11434/v1
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=not-needed
# A model your server has pulled. For grading with figures, use a
# vision-capable model (e.g. qwen2.5-vl); text-only models still grade code.
LOCAL_MODEL=qwen2.5-coder:7b

# ── Anthropic Claude (used when LLM_PROVIDER=anthropic) ──────
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_GRADING_MODEL=claude-opus-5
ANTHROPIC_RUBRIC_MODEL=claude-opus-5

# ── Database ─────────────────────────────────────────────────
# SQLite is fine for local development only. Production REFUSES to start on
# SQLite: the API and the grading worker are separate processes sharing one
# database, and job claiming needs PostgreSQL's FOR UPDATE SKIP LOCKED.
#   development: sqlite:///./autograde.db
#   production:  postgresql+psycopg2://autograde:PASSWORD@db:5432/autograde
DATABASE_URL=sqlite:///./autograde.db

# Password for the bundled PostgreSQL service (docker compose). No default -
# compose refuses to start without it. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────
# CHANGE THIS. Anyone with this value can forge a login token for any
# account. Production refuses to start on the default or on a placeholder.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate_a_random_secret_here
ALGORITHM=HS256
# 480 minutes = 8 hours, one working day.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── File uploads ─────────────────────────────────────────────
# Student submissions land here. Back this up — grades live in the
# database, but the original files do not.
UPLOAD_DIR=./uploads
# Enforced while streaming, before the file reaches disk.
MAX_FILE_SIZE_MB=50
# Blanket cap on any request body, enforced by middleware and by the proxy.
MAX_REQUEST_BODY_MB=300

# ── Grading model calls ──────────────────────────────────────
# Per-request ceiling. Both SDKs default to 600s, which is long enough for
# one stalled call to hold up everything behind it in a batch.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# ── Who may create an account ────────────────────────────────
# false (recommended): only the administrator creates accounts, from
#   Settings -> Account inside the app. The FIRST account created on a
#   fresh install is always allowed and becomes the administrator.
# true: anyone who can reach the sign-in page can sign themselves up.
#   Only sensible on a private network you fully control.
ALLOW_OPEN_REGISTRATION=false

# ── Environment ──────────────────────────────────────────────
# development | test | production
# "production" enables JSON logging and enforces the safety checks above.
ENVIRONMENT=development

# Origins allowed to call the API from a browser, comma-separated. In
# production this is your public hostname.
#   CORS_ORIGINS=https://autograde.university.edu
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ── Reverse proxy (docker compose production stack) ──────────
# The public hostname Caddy answers on and requests a certificate for.
# Use `localhost` for a local trial run; a real DNS name in production.
PUBLIC_HOSTNAME=localhost
# Where Let's Encrypt sends expiry warnings. Leave blank for `localhost`.
ACME_EMAIL=

# ── Professors' own API keys (BYOK) ──────────────────────────
# Each professor may save their own provider key under Settings -> AI
# providers. Those keys are encrypted at rest with this value. If it is
# blank the encryption key is derived from SECRET_KEY, which means
# rotating SECRET_KEY makes every saved provider key undecryptable and
# each professor must re-enter theirs. Set it explicitly if you expect to
# rotate the JWT secret.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CREDENTIAL_ENCRYPTION_KEY=

# ── Backups ──────────────────────────────────────────────────
# How often the backup container dumps the database, and how many daily
# dumps to keep before the oldest is deleted.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30

# ── Canvas LMS (optional — leave blank if not using) ─────────
# See docs/canvas_setup.md. Without these, the Canvas CSV export still
# works; only roster sync and grade push-back are disabled.
CANVAS_BASE_URL=
CANVAS_API_TOKEN=
