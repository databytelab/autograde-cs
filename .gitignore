# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
venv/
.venv/
env/

# Environment variables - NEVER commit these
.env
.env.*
!.env.example

# Database files
*.db
*.sqlite
*.sqlite3
# SQLite runs in WAL mode (see backend/database.py), which writes these
# sidecar files. They hold real committed data - never commit them.
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm

# Uploads - student files stay local
uploads/

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# VSCode
.vscode/settings.json
.vscode/launch.json

# Docker
*.override.yml

# Distribution / packaging
dist/
build/
*.egg-info/

# Node
node_modules/
.next/
